# CPack post-build gate: fail packaging if a produced archive contains
# top-level entries beyond the reviewed allowlist, or if any first-party file
# references the build machine (source tree or home directory). Third-party
# payload directories (bundled toolchain/SDL) are exempt from the string scan
# — they are upstream artifacts built elsewhere. Configured by
# CMakeLists.txt; runs automatically after `cpack` creates each archive.

set(_leak_patterns "@SNESBUILD_LEAK_PATTERNS@")
set(_allowed_toplevel "@SNESBUILD_ALLOWED_TOPLEVEL@")
set(_scan_exempt "@SNESBUILD_SCAN_EXEMPT_DIRS@")
set(_runtime_archive_relative "@SNESBUILD_RUNTIME_ARCHIVE_RELATIVE@")
set(_runtime_source_paths "@SNESBUILD_RUNTIME_SOURCE_PATHS@")
set(_required_sdl_runtime "@SNESBUILD_REQUIRED_SDL_RUNTIME@")
set(_required_ttf_runtime "@SNESBUILD_REQUIRED_TTF_RUNTIME@")
set(_required_ttf_link "@SNESBUILD_REQUIRED_TTF_LINK@")
set(_required_license_files
    "utils/LICENSE"
    "utils/LICENSE_SCOPE.md"
    "utils/ATTRIBUTION.md"
    "utils/THIRD_PARTY_NOTICES.md"
    "utils/third_party/sheenbidi/LICENSE"
    "utils/licenses/SheenBidi/LICENSE"
    "utils/game-assets/fonts/noto/OFL.txt"
    "utils/game-assets/fonts/noto/NotoSansJP-OFL.txt"
    "utils/snesrecomp-go/runtime/LICENSE"
    "utils/snesrecomp-go/runtime/NOTICE.md"
    "utils/snesrecomp-go/runtime/PROVENANCE.md"
    "utils/snesrecomp-go/runtime/licenses/Snaggletooth-LICENSE.txt")

foreach(_package IN LISTS CPACK_PACKAGE_FILES)
    get_filename_component(_package "${_package}" ABSOLUTE)
    set(_stage "${_package}.leakcheck")
    file(REMOVE_RECURSE "${_stage}")
    file(MAKE_DIRECTORY "${_stage}")
    execute_process(
        COMMAND ${CMAKE_COMMAND} -E tar xf "${_package}"
        WORKING_DIRECTORY "${_stage}"
        RESULT_VARIABLE _extract_result)
    if(NOT _extract_result EQUAL 0)
        message(FATAL_ERROR "leak check: cannot extract ${_package}")
    endif()

    # Archives contain a single versioned root directory.
    file(GLOB _roots LIST_DIRECTORIES true "${_stage}/*")
    list(LENGTH _roots _root_count)
    if(NOT _root_count EQUAL 1)
        message(FATAL_ERROR "leak check: expected one root directory in ${_package}")
    endif()
    list(GET _roots 0 _root)

    # Distribution bundles consume the runner as a target-keyed binary SDK.
    # Shipping implementation sources would silently restore the slower,
    # host-dependent source fallback and make cross-target releases differ.
    if(NOT EXISTS "${_root}/${_runtime_archive_relative}")
        message(FATAL_ERROR
            "runner SDK check: ${_package} is missing ${_runtime_archive_relative}")
    endif()
    file(SIZE "${_root}/${_runtime_archive_relative}" _runtime_archive_size)
    if(_runtime_archive_size EQUAL 0)
        message(FATAL_ERROR
            "runner SDK check: ${_runtime_archive_relative} is empty in ${_package}")
    endif()
    foreach(_source_path IN LISTS _runtime_source_paths)
        if(EXISTS "${_root}/${_source_path}")
            message(FATAL_ERROR
                "runner SDK check: source-build payload ${_source_path} leaked into ${_package}")
        endif()
    endforeach()
    if(NOT _required_sdl_runtime STREQUAL "" AND
       NOT EXISTS "${_root}/${_required_sdl_runtime}")
        message(FATAL_ERROR
            "bundled SDL check: ${_package} is missing ${_required_sdl_runtime}")
    endif()
    foreach(_license_file IN LISTS _required_license_files)
        if(NOT EXISTS "${_root}/${_license_file}")
            message(FATAL_ERROR
                "license check: ${_package} is missing ${_license_file}")
        endif()
    endforeach()
    foreach(_bidi_source
            "utils/third_party/sheenbidi/Source/SheenBidi.c"
            "utils/third_party/sheenbidi/Headers/SheenBidi/SheenBidi.h"
            "utils/src/platform/sdl/bidi_text_sdl.c")
        if(NOT EXISTS "${_root}/${_bidi_source}")
            message(FATAL_ERROR "localization distribution check: missing ${_bidi_source}")
        endif()
    endforeach()
    foreach(_language_file IN ITEMS
            "utils/docs/language-packs.md" "utils/docs/language-pack-format.md"
            "utils/docs/language-authoring-reference.json" "utils/docs/language-archive.schema.json"
            "utils/examples/language-pack/pack.ini" "utils/examples/language-pack/text/example.artext"
            "utils/examples/example.fr-ca.arlang")
        if(NOT EXISTS "${_root}/${_language_file}")
            message(FATAL_ERROR "localization distribution check: missing public artifact ${_language_file}")
        endif()
    endforeach()
    foreach(_font_file IN ITEMS "NotoSans-SemiCondensedExtraBold.ttf" "NotoSansJP-Bold.otf"
            "NotoSansArabic-Bold.ttf" "NotoSansHebrew-Bold.ttf")
        set(_font_path "${_root}/utils/game-assets/fonts/noto/${_font_file}")
        if(NOT EXISTS "${_font_path}")
            message(FATAL_ERROR "interface font check: missing ${_font_file}")
        endif()
        file(SIZE "${_font_path}" _font_size)
        if(_font_size EQUAL 0)
            message(FATAL_ERROR "interface font check: empty ${_font_file}")
        endif()
    endforeach()
    if(NOT _required_ttf_runtime STREQUAL "")
        foreach(_ttf_file IN ITEMS "${_required_ttf_runtime}" "${_required_ttf_link}"
                "utils/tools/sdl3/include/SDL3_ttf/SDL_ttf.h"
                "utils/tools/sdl3/licenses/SDL3_ttf/LICENSE.txt"
                "utils/licenses/SDL3_ttf/LICENSE.txt"
                "utils/licenses/SDL3_ttf/FreeType-FTL.txt"
                "utils/licenses/SDL3_ttf/HarfBuzz-COPYING.txt"
                "utils/licenses/SDL3_ttf/PlutoSVG-LICENSE.txt"
                "utils/licenses/SDL3_ttf/PlutoVG-LICENSE.txt")
            if(NOT EXISTS "${_root}/${_ttf_file}")
                message(FATAL_ERROR "SDL3_ttf package check: missing ${_ttf_file}")
            endif()
        endforeach()
    endif()

    file(GLOB _entries LIST_DIRECTORIES true RELATIVE "${_root}" "${_root}/*")
    foreach(_entry IN LISTS _entries)
        if(NOT _entry IN_LIST _allowed_toplevel)
            message(FATAL_ERROR
                "leak check: unexpected top-level entry in ${_package}: ${_entry}")
        endif()
    endforeach()

    file(GLOB_RECURSE _files LIST_DIRECTORIES false RELATIVE "${_root}" "${_root}/*")
    set(_checked 0)
    foreach(_file IN LISTS _files)
        string(TOLOWER "${_file}" _localization_path)
        # These two exact, independently authored examples are checked against
        # their source/Go publication in tests. Never exempt an entire directory
        # or file extension: extracted retail scripts remain forbidden.
        set(_authored_example FALSE)
        if(_file STREQUAL "utils/examples/language-pack/text/example.artext" OR
           _file STREQUAL "utils/examples/example.fr-ca.arlang")
            set(_authored_example TRUE)
        endif()
        if((_localization_path MATCHES "\\.(sfc|smc|srm|rec|artext|arproject|arlang)$" AND NOT _authored_example) OR
           _localization_path MATCHES "^utils/(development|runs)/" OR
           _localization_path MATCHES "^utils/game-assets/languages/" OR
           _localization_path MATCHES "^utils/game-assets/workshop/")
            message(FATAL_ERROR "localization distribution check: local-only payload ${_file}")
        endif()
        set(_exempt FALSE)
        foreach(_dir IN LISTS _scan_exempt)
            if(_file MATCHES "^${_dir}/")
                set(_exempt TRUE)
                break()
            endif()
        endforeach()
        if(_exempt)
            continue()
        endif()
        foreach(_pattern IN LISTS _leak_patterns)
            file(STRINGS "${_root}/${_file}" _hits REGEX "${_pattern}" LIMIT_COUNT 1)
            if(_hits)
                message(FATAL_ERROR
                    "leak check: ${_file} in ${_package} contains build-machine "
                    "path matching '${_pattern}': ${_hits}")
            endif()
        endforeach()
        math(EXPR _checked "${_checked} + 1")
    endforeach()
    file(REMOVE_RECURSE "${_stage}")
    message(STATUS "leak check: ${_package} clean (${_checked} first-party files scanned)")
endforeach()
