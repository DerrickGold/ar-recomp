  "indirect_details": {
    "action_map": {
      "classification": "verified_non_language_action_tilemap",
      "destination": "$7E:8000 or $7E:C000 action map",
      "proof": "the command-4 destination table contains the two action map workspaces; the copy length is the decoded map size"
    },
    "asset_workspace": {
      "classification": "verified_non_language_asset_workspace",
      "destination": "$7E:6000-$7E:67FF",
      "proof": "the command-5 asset path initializes the destination to $6000 and copies $0800 bytes"
    },
    "character_vram_readback": {
      "classification": "verified_non_language_character_graphics_snapshot",
      "destination": "$7F:B800-$7F:BFFF",
      "proof": "the VRAM readback path fixes the destination at $B800 and copies $1000 bytes; this is outside the text canvas $B000-$B7FF"
    },
    "deferred_ppu_register": {
      "classification": "verified_non_language_ppu_register_write",
      "destination": "$00:2100-$00:2132 selected PPU registers",
      "proof": "all producers install a bank-$00 PPU-register address before the NMI tail performs the deferred byte store"
    },
    "developed_world_map": {
      "classification": "verified_non_language_world_map_tilemap",
      "destination": "$7E:C000-$7E:FFFF",
      "proof": "the world-map load path fixes the destination at $C000 and copies $4000 bytes"
    },
    "developed_world_map_stamp": {
      "classification": "verified_non_language_world_map_tilemap",
      "destination": "$7E:C000-$7E:FFFF",
      "proof": "the owning routine initializes the long pointer to $C000 and stamps the developed Mode-7 map"
    },
    "lzss_ring": {
      "classification": "verified_non_language_lzss_ring_buffer",
      "destination": "$7E:2000-$7E:20FF",
      "proof": "the decompressor initializes its bank-$7E circular output pointer to $2000 and wraps its low byte"
    },
    "metatile_definitions": {
      "classification": "verified_non_language_metatile_definitions",
      "destination": "$7E:2100/$2900/$3100 definition tables",
      "proof": "the only callers select the three fixed metatile-table bases before byte-swapping the decompressed words"
    },
    "oam_high_table": {
      "classification": "verified_non_language_oam_bit_table",
      "destination": "$7E:0580-$7E:05FF",
      "proof": "the owning renderer initializes the pointer to $0580 and uses it as the 128-byte OAM high table"
    }
  },
