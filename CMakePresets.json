{
  "version": 6,
  "configurePresets": [
    {
      "name": "dev",
      "displayName": "Dev (Debug, tests, no sanitizers)",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "AR_SIM3D_TERRAIN_ELEVATION": "ON",
        "ACTRAISER_ENABLE_RUN_DIR_BY_DEFAULT": "ON",
        "SNESRECOMP_ENABLE_TRACE_RECORDER": "ON",
        "SNESRECOMP_ENABLE_TRACE": "OFF",
        "AR_SANITIZE": "OFF",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "play",
      "displayName": "Play (RelWithDebInfo, optimized)",
      "binaryDir": "${sourceDir}/build-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "AR_SIM3D_TERRAIN_ELEVATION": "ON",
        "ACTRAISER_ENABLE_RUN_DIR_BY_DEFAULT": "OFF",
        "SNESRECOMP_ENABLE_TRACE_RECORDER": "OFF",
        "SNESRECOMP_ENABLE_TRACE": "OFF",
        "SNESRECOMP_WATCHDOG": "OFF",
        "AR_SANITIZE": "OFF",
        "BUILD_TESTING": "OFF"
      }
    },
    {
      "name": "control",
      "displayName": "Flat terrain control (RelWithDebInfo, optimized)",
      "binaryDir": "${sourceDir}/build-control",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "AR_SIM3D_TERRAIN_ELEVATION": "OFF",
        "ACTRAISER_ENABLE_RUN_DIR_BY_DEFAULT": "OFF",
        "SNESRECOMP_ENABLE_TRACE_RECORDER": "OFF",
        "SNESRECOMP_ENABLE_TRACE": "OFF",
        "SNESRECOMP_WATCHDOG": "OFF",
        "AR_SANITIZE": "OFF",
        "BUILD_TESTING": "OFF"
      }
    },
    {
      "name": "asan",
      "displayName": "ASan+UBSan (corruption hunts, slow)",
      "binaryDir": "${sourceDir}/build-asan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "AR_SIM3D_TERRAIN_ELEVATION": "ON",
        "ACTRAISER_ENABLE_RUN_DIR_BY_DEFAULT": "ON",
        "SNESRECOMP_ENABLE_TRACE_RECORDER": "OFF",
        "SNESRECOMP_ENABLE_TRACE": "OFF",
        "AR_SANITIZE": "ON",
        "BUILD_TESTING": "OFF"
      }
    },
    {
      "name": "trace",
      "displayName": "Trace (SNESRECOMP_ENABLE_TRACE instrumentation)",
      "binaryDir": "${sourceDir}/build-trace",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "AR_SIM3D_TERRAIN_ELEVATION": "ON",
        "ACTRAISER_ENABLE_RUN_DIR_BY_DEFAULT": "ON",
        "SNESRECOMP_ENABLE_TRACE": "ON",
        "SNESRECOMP_ENABLE_TRACE_RECORDER": "ON",
        "AR_SANITIZE": "OFF",
        "BUILD_TESTING": "OFF"
      }
    },
    {
      "name": "tests-base",
      "hidden": true,
      "generator": "Ninja",
      "cacheVariables": {
        "AR_TESTS_ONLY": "ON",
        "BUILD_TESTING": "ON",
        "AR_SANITIZE": "OFF",
        "AR_TSAN": "OFF",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "tests-debug",
      "displayName": "ROM-free tests (Debug)",
      "inherits": "tests-base",
      "binaryDir": "${sourceDir}/build-check"
    },
    {
      "name": "tests-release",
      "displayName": "ROM-free tests (Release)",
      "inherits": "tests-base",
      "binaryDir": "${sourceDir}/build-tests-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "tests-asan",
      "displayName": "ROM-free tests (ASan + UBSan)",
      "inherits": "tests-base",
      "binaryDir": "${sourceDir}/build-tests-asan",
      "cacheVariables": {
        "AR_SANITIZE": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "dev", "configurePreset": "dev", "jobs": 8 },
    { "name": "play", "configurePreset": "play", "jobs": 8 },
    { "name": "control", "configurePreset": "control", "jobs": 8 },
    { "name": "asan", "configurePreset": "asan", "jobs": 8 },
    { "name": "trace", "configurePreset": "trace", "jobs": 8 },
    { "name": "tests-debug", "configurePreset": "tests-debug", "jobs": 8 },
    { "name": "tests-release", "configurePreset": "tests-release", "jobs": 8 },
    { "name": "tests-asan", "configurePreset": "tests-asan", "jobs": 8 }
  ],
  "testPresets": [
    { "name": "dev", "configurePreset": "dev", "output": { "outputOnFailure": true } },
    { "name": "tests-debug", "configurePreset": "tests-debug", "output": { "outputOnFailure": true } },
    { "name": "tests-release", "configurePreset": "tests-release", "output": { "outputOnFailure": true } },
    { "name": "tests-asan", "configurePreset": "tests-asan", "output": { "outputOnFailure": true } }
  ]
}
