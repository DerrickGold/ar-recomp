{
  "$schema": "https://recomplauncher.com/schema/recomplauncher.json",
  "format": 1,
  "name": "ActRaiser Recomp",
  "inputs": [
    {
      "id": "rom",
      "label": "ActRaiser (USA) ROM — required base game",
      "optional": false,
      "formats": [{"type": "file", "extensions": ["sfc", "smc"]}],
      "dumps": [{"name": "ActRaiser (USA) (Rev 0)", "size": 1048576, "crc32": "eac3358d"}]
    },
    {
      "id": "rom-jp",
      "label": "ActRaiser (Japan) ROM — optional regional text, art and music",
      "optional": true,
      "formats": [{"type": "file", "extensions": ["sfc", "smc"]}],
      "dumps": [{"name": "ActRaiser (Japan) (Rev 0)", "size": 1048576, "crc32": "bee9b30c"}]
    },
    {
      "id": "rom-eu-en",
      "label": "ActRaiser (Europe, English) ROM — optional regional text, art and music",
      "optional": true,
      "formats": [{"type": "file", "extensions": ["sfc", "smc"]}],
      "dumps": [{"name": "ActRaiser (Europe, English) (Rev 0)", "size": 1048576, "crc32": "09097b2b"}]
    },
    {
      "id": "rom-de",
      "label": "ActRaiser (Germany) ROM — optional regional text, art and music",
      "optional": true,
      "formats": [{"type": "file", "extensions": ["sfc", "smc"]}],
      "dumps": [{"name": "ActRaiser (Germany) (Rev 0)", "size": 1048576, "crc32": "29a78af9"}]
    },
    {
      "id": "rom-fr",
      "label": "ActRaiser (France) ROM — optional regional text, art and music",
      "optional": true,
      "formats": [{"type": "file", "extensions": ["sfc", "smc"]}],
      "dumps": [{"name": "ActRaiser (France) (Rev 0)", "size": 1048576, "crc32": "a27e2664"}]
    },
    {
      "id": "rom-ar2-us",
      "label": "ActRaiser 2 (USA) ROM — optional bonus character and development content",
      "optional": true,
      "formats": [{"type": "file", "extensions": ["sfc", "smc"]}],
      "dumps": [{"name": "ActRaiser 2 (USA) (Rev 0)", "size": 1572864, "crc32": "4901f718"}]
    }
  ],
  "start": {
    "program": ["ActRaiserRecompBuilder.exe"],
    "args": ["--play-session", "--output-dir={install}/ActRaiserRecomp", "--mods-dir={install}/mods", "--build-on-first-run",
      "--rom={input:rom}", "--rom={input:rom-jp}", "--rom={input:rom-eu-en}",
      "--rom={input:rom-de}", "--rom={input:rom-fr}", "--rom={input:rom-ar2-us}"]
  },
  "saves": ["{install}/ActRaiserRecomp/saves"],
  "folders": {
    "saves": [{"path": "{install}/ActRaiserRecomp/saves"}],
    "logs": [{"path": "{install}/ActRaiserRecomp/logs"}]
  },
  "looks": {
    "allowed": false,
    "reason": "This entry starts the Builder. Set visual effects in ActRaiser Recomp."
  }
}
